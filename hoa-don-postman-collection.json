{
  "info": {
    "_postman_id": "3a910fe2-c8bf-4b4d-8d7b-hoa-don-docs",
    "name": "Pharmacity Hoa Don API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "admin_token", "value": "" },
    { "key": "staff_token", "value": "" },
    { "key": "invoice_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth - Login Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "pm.test('Type is admin', function () { pm.expect(data.type).to.eql('admin'); });",
              "pm.collectionVariables.set('admin_token', data.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ten_dang_nhap\": \"admin\",\n  \"password\": \"password\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/api/login"
      }
    },
    {
      "name": "Auth - Login Staff",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "pm.test('Type is staff', function () { pm.expect(data.type).to.eql('staff'); });",
              "pm.collectionVariables.set('staff_token', data.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ten_dang_nhap\": \"staff\",\n  \"password\": \"password\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/api/login"
      }
    },
    {
      "name": "Staff - Create Hoa Don",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "const data = pm.response.json();",
              "pm.test('Has invoice id', function () { pm.expect(data.data.id_hoa_don).to.be.a('number'); });",
              "pm.collectionVariables.set('invoice_id', data.data.id_hoa_don);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{staff_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_khach_hang\": 1,\n  \"tong_tien\": 550000,\n  \"giam_gia\": 25000,\n  \"ngay_ban\": \"2026-03-18 09:00:00\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/api/hoa-dons"
      }
    },
    {
      "name": "Staff - List Hoa Don",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "pm.test('Data is array', function () { pm.expect(data.data).to.be.an('array'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{staff_token}}" }
        ],
        "url": "{{base_url}}/api/hoa-dons"
      }
    },
    {
      "name": "Staff - Detail Hoa Don",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "pm.test('Returned correct invoice', function () { pm.expect(String(data.data.id_hoa_don)).to.eql(String(pm.collectionVariables.get('invoice_id'))); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{staff_token}}" }
        ],
        "url": "{{base_url}}/api/hoa-dons/{{invoice_id}}"
      }
    },
    {
      "name": "Staff - Search Hoa Don",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "pm.test('Search returns array', function () { pm.expect(data.data).to.be.an('array'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{staff_token}}" }
        ],
        "url": "{{base_url}}/api/hoa-dons/search?q=HD"
      }
    },
    {
      "name": "Admin - List Hoa Don",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response has data', function () { pm.expect(pm.response.json().data).to.be.an('array'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{admin_token}}" }
        ],
        "url": "{{base_url}}/api/admin/hoa-dons"
      }
    },
    {
      "name": "Admin - Detail Hoa Don",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{admin_token}}" }
        ],
        "url": "{{base_url}}/api/admin/hoa-dons/{{invoice_id}}"
      }
    },
    {
      "name": "Admin - Search Hoa Don",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{admin_token}}" }
        ],
        "url": "{{base_url}}/api/admin/hoa-dons/search?q=HD"
      }
    },
    {
      "name": "Admin - Statistics Hoa Don",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "pm.test('Statistics contain overview', function () { pm.expect(data.data.tong_quan).to.be.an('object'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{admin_token}}" }
        ],
        "url": "{{base_url}}/api/admin/hoa-dons/statistics?from=2026-03-01&to=2026-03-31"
      }
    }
  ]
}
